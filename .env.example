# Active Reserve, on-chain side. Real values live ONLY in a local .env (gitignored).
# Nothing here is a secret by itself; the two keys below are, so treat this file as a checklist.

# --- always needed ---
ARBITRUM_RPC_URL=
# Fork target for `pnpm fork:all` and the Foundry fork suites. Defaults to the public Arbitrum
# endpoint when unset, so the test suite runs from a clean checkout with no setup.
FORK_RPC_URL=

# --- launch and ops (RUNBOOK.md) ---
# Contract verification on Arbiscan (RUNBOOK section 1).
ARBISCAN_API_KEY=
# Murilo's manager wallet. Signs every privileged tx from a ledger; no private key ever lives here.
MANAGER_ADDRESS=
# Deposit cap in USDC units, 6 decimals. Deploy refuses anything above 1000 USDC.
MAX_TVL_USDC=
# Set after the deploy; every Ops script reads it.
VAULT_ADDRESS=
# SeedAndPark (RUNBOOK section 2). SEED_USDC in 6 decimals, BUFFER_BPS 500 = keep 5 percent hot.
SEED_USDC=
BUFFER_BPS=
# ShipBand (RUNBOOK section 3). ORDER_BYTES is the ABI-encoded Order struct from the compiler.
ORDER_BYTES=
SHIP_USDC=
# DockBand (RUNBOOK section 5), the dock half of a roll.
STRATEGY_HASH=

# --- taker bot (POO-1066), the only key this repo uses ---
# Its own wallet, holding only working capital. Never the manager key.
TAKER_BOT_PRIVATE_KEY=

# Removed deliberately: DATABASE_URL (the database and its credential live in the frontend repo, per
# structure v3, and no on-chain script here touches it) and KEEPER_PRIVATE_KEY (the keeper loop is
# cut for the window, POO-1069; every operation is a manual manager action).

# Manager signer: the raw key keeps a live demo from stopping at a password prompt.
# Alternative: cast wallet import manager --interactive, then --account manager.
MANAGER_PRIVATE_KEY=

# Ship sizing used by scripts/build-orders.ts (combined stays inside the 10 percent sleeve)
DEMO_SHIP_USDC=600000
PROD_SHIP_USDC=350000
