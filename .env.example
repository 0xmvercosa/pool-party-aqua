# Active Reserve launch env. Real values live ONLY in local .env (gitignored).
# See docs/05_DEMO_WALKTHROUGH.md for the full reproduction sequence.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBISCAN_API_KEY=

# Manager wallet: deploys, seeds, ships, docks. Either the raw key (no password prompt during
# a live demo) or a keystore account (cast wallet import manager) with --account manager.
MANAGER_PRIVATE_KEY=
MANAGER_ADDRESS=

# Taker wallet: separate, holds only its own working capital (BOT-R4).
TAKER_BOT_PRIVATE_KEY=

# Launch parameters
MAX_TVL_USDC=200000000
SEED_USDC=9500000
BUFFER_BPS=500
DEMO_SHIP_USDC=600000
PROD_SHIP_USDC=350000

# Filled during the run
VAULT_ADDRESS=
# ORDER_BYTES / SHIP_USDC: exported per band right before each ShipBand
